# Local development database (Docker Compose)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/anatomy_explorer?schema=public"

# Used by Prisma migrations (same local Postgres in local-first mode)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/anatomy_explorer?schema=public"

# Redis local development connection
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"
